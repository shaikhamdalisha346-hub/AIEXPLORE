# ==============================================================================
# AI TOOL FINDER — External Review Sources Environment Configuration
# ==============================================================================
# Optional API credentials for third-party commercial review platforms.
# When credentials are provided, the server queries the platform's official API.
# When credentials are not provided, the platform displays a verified direct link
# to the tool's original review page without scraping or inventing ratings.
#
# NOTE: Apple App Store uses Apple's open public iTunes Lookup API and requires
# NO API KEY to fetch live, verified ratings and review counts.
# ==============================================================================

# G2 Developer / Partner API Key (https://data.g2.com/)
G2_API_KEY=

# Trustpilot Consumer / Business API Key (https://developers.trustpilot.com/)
TRUSTPILOT_API_KEY=

# Product Hunt API Developer Token (https://api.producthunt.com/v2/docs)
PRODUCT_HUNT_API_TOKEN=

# Capterra / Gartner Digital Markets API Key
CAPTERRA_API_KEY=
